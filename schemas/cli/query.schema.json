{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QueryResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["columns", "rows"],
  "properties": {
    "columns": {"type": "array", "items": {"type": "string"}},
    "rows": {
      "type": "array",
      "items": {"type": "array"},
      "description": "Strict JSON: a NaN or infinite DOUBLE is null and a BLOB is its lowercase hex digits."
    }
  }
}
