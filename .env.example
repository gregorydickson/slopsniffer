# Copy to .env (git-ignored) at the repo root, or point $SLOPSNIFFER_ENV_FILE at a file.
# Real environment variables win over this file. Values are taken literally.

# Issue-tracker keys to link sessions to, as an RE2 pattern (case-insensitive, word-bounded,
# stored upper-cased). Unset or empty = no ticket links.
# SLOPSNIFFER_TICKET_PATTERN=ACME-\d+

# Other variables that may be set here:
# SLOPSNIFFER_CONFIG=~/.config/slopsniffer/config.toml
# SLOPSNIFFER_HOME=~/.local/share/slopsniffer
